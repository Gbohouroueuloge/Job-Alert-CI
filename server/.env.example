APP_NAME="JobAlert CI API"
APP_ENV=development
APP_TIMEZONE=Africa/Abidjan
CORS_ORIGINS=http://localhost:5173

# Dev local rapide
DATABASE_URL=sqlite:///./jobalert.db
AUTO_CREATE_TABLES=false

